2026-09-17 18:11:42.513 CST [13553] STATEMENT:  CREATE OR REPLACE FUNCTION test_live2_bump_product_workspace() RETURNS trigger
	LANGUAGE plpgsql AS $$
	BEGIN
	  UPDATE worker_workspaces w SET revision=revision+1
	  FROM tasks t
	  WHERE t.company_id=NEW.company_id AND t.id=NEW.task_id
	    AND w.company_id=t.company_id AND w.task_id=t.id
	    AND t.kind='compat' AND t.owner='emp-backend';
	  RETURN NEW;
	END;
	$$
