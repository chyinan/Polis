	  WHERE i.employee_id IS NOT NULL AND i.task_id IS NOT NULL AND i.employee_id<>t.owner
	 ) THEN
	  RAISE EXCEPTION 'cannot migrate mismatched employee/task operator instructions';
	 END IF;
