  "thread_start_payload_canonical_json": "{\"allowProviderModelFallback\":false,\"approvalPolicy\":\"never\",\"config\":{\"model_reasoning_effort\":\"medium\"},\"cwd\":\"/work\",\"developerInstructions\":\"Do not call tools.\\nReply only with the transport sentinel.\",\"dynamicTools\":[{\"description\":\"Read your backend task, v1 starting contract, assigned peer task, and observable tool-call budget.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{},\"required\":[],\"type\":\"object\"},\"name\":\"polis_work_current\",\"type\":\"function\"},{\"description\":\"Read the approved v1 task context and observable tool-call budget only.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{},\"required\":[],\"type\":\"object\"},\"name\":\"polis_context_read\",\"type\":\"function\"},{\"description\":\"Read the backend workspace and current digest.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{},\"required\":[],\"type\":\"object\"},\"name\":\"polis_workspace_read\",\"type\":\"function\"},{\"description\":\"Replace your own backend workspace using its expected digest.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"content\":{\"maxLength\":4096,\"type\":\"string\"},\"expected_digest\":{\"type\":\"string\"}},\"required\":[\"content\",\"expected_digest\"],\"type\":\"object\"},\"name\":\"polis_workspace_replace\",\"type\":\"function\"},{\"description\":\"Propose the next contract revision for the peer task.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"endpoint\":{\"maxLength\":512,\"type\":\"string\"},\"schema\":{\"maxLength\":2048,\"type\":\"string\"}},\"required\":[\"endpoint\",\"schema\"],\"type\":\"object\"},\"name\":\"polis_contract_propose\",\"type\":\"function\"},{\"description\":\"Accept a contract revision you proposed.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"revision_id\":{\"type\":\"string\"}},\"required\":[\"revision_id\"],\"type\":\"object\"},\"name\":\"polis_contract_accept\",\"type\":\"function\"},{\"description\":\"Read an exact contract revision by its persisted id.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"revision_id\":{\"type\":\"string\"}},\"required\":[\"revision_id\"],\"type\":\"object\"},\"name\":\"polis_contract_read\",\"type\":\"function\"},{\"description\":\"Send a direct actionable collaboration message to the peer employee's current peer task. Use the explicit employee ID and task ID returned by work_current; to_task is not accepted.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"actionable\":{\"type\":\"boolean\"},\"body\":{\"maxLength\":4096,\"type\":\"string\"},\"contract_revision_id\":{\"type\":\"string\"},\"to_employee_id\":{\"type\":\"string\"},\"to_task_id\":{\"type\":\"string\"}},\"required\":[\"actionable\",\"body\",\"contract_revision_id\",\"to_employee_id\",\"to_task_id\"],\"type\":\"object\"},\"name\":\"polis_collab_send\",\"type\":\"function\"},{\"description\":\"Run the mediated peer candidate check and receive an evidence receipt.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{},\"required\":[],\"type\":\"object\"},\"name\":\"polis_workspace_check\",\"type\":\"function\"},{\"description\":\"Persist a progress or qualified peer checkpoint. Progress checkpoints preserve incomplete work; qualified checkpoints require passed check evidence and are eligible for final artifact submission.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"decisions\":{\"items\":{\"maxLength\":512,\"type\":\"string\"},\"maxItems\":8,\"minItems\":1,\"type\":\"array\"},\"evidence_refs\":{\"items\":{\"maxLength\":512,\"type\":\"string\"},\"maxItems\":8,\"minItems\":1,\"type\":\"array\"},\"facts\":{\"items\":{\"maxLength\":512,\"type\":\"string\"},\"maxItems\":8,\"minItems\":1,\"type\":\"array\"},\"failed_checks\":{\"items\":{\"maxLength\":512,\"type\":\"string\"},\"maxItems\":8,\"type\":\"array\"},\"kind\":{\"enum\":[\"progress\",\"qualified\"],\"type\":\"string\"},\"next_action\":{\"maxLength\":512,\"type\":\"string\"},\"rejected\":{\"items\":{\"maxLength\":512,\"type\":\"string\"},\"maxItems\":8,\"minItems\":1,\"type\":\"array\"},\"summary\":{\"maxLength\":512,\"type\":\"string\"}},\"required\":[\"decisions\",\"evidence_refs\",\"facts\",\"failed_checks\",\"kind\",\"next_action\",\"rejected\",\"summary\"],\"type\":\"object\"},\"name\":\"polis_work_checkpoint\",\"type\":\"function\"},{\"description\":\"Submit your checked backend candidate.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{},\"required\":[],\"type\":\"object\"},\"name\":\"polis_artifact_submit\",\"type\":\"function\"}],\"environments\":[],\"ephemeral\":true,\"model\":\"gpt-5.6-luna\",\"sandbox\":\"read-only\"}",
