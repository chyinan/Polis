  "thread_start_payload_canonical_json": "{\"allowProviderModelFallback\":false,\"approvalPolicy\":\"never\",\"config\":{\"model_reasoning_effort\":\"medium\"},\"cwd\":\"/work\",\"developerInstructions\":\"Do not call tools.\\nReply only with the transport sentinel.\",\"dynamicTools\":[{\"description\":\"Read your frontend task, v1 starting contract, neutral handover state, and observable tool-call budget.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{},\"required\":[],\"type\":\"object\"},\"name\":\"polis_work_current\",\"type\":\"function\"},{\"description\":\"Read the approved v1 task context and observable tool-call budget only.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{},\"required\":[],\"type\":\"object\"},\"name\":\"polis_context_read\",\"type\":\"function\"},{\"description\":\"Read your own frontend workspace and current digest.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{},\"required\":[],\"type\":\"object\"},\"name\":\"polis_workspace_read\",\"type\":\"function\"},{\"description\":\"Receive the persisted peer message and exact contract revision sent to this task.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{},\"required\":[],\"type\":\"object\"},\"name\":\"polis_collab_inbox\",\"type\":\"function\"},{\"description\":\"Read an exact contract revision by its persisted id.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"revision_id\":{\"type\":\"string\"}},\"required\":[\"revision_id\"],\"type\":\"object\"},\"name\":\"polis_contract_read\",\"type\":\"function\"},{\"description\":\"Acknowledge an observed peer message without resolving its obligation.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"message_id\":{\"type\":\"string\"}},\"required\":[\"message_id\"],\"type\":\"object\"},\"name\":\"polis_collab_ack\",\"type\":\"function\"},{\"description\":\"Record that a workspace change applied the current peer obligation. Use obligation_id, contract_revision_id, workspace_revision and receipt IDs in evidence_refs[]; this tool does not write the workspace or accept source content.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"contract_revision_id\":{\"type\":\"string\"},\"evidence_refs\":{\"items\":{\"maxLength\":512,\"type\":\"string\"},\"maxItems\":8,\"minItems\":1,\"type\":\"array\"},\"obligation_id\":{\"type\":\"string\"},\"workspace_revision\":{\"minimum\":1,\"type\":\"integer\"}},\"required\":[\"contract_revision_id\",\"evidence_refs\",\"obligation_id\",\"workspace_revision\"],\"type\":\"object\"},\"name\":\"polis_collab_apply\",\"type\":\"function\"},{\"description\":\"Replace your own frontend workspace using its expected digest.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"content\":{\"maxLength\":4096,\"type\":\"string\"},\"expected_digest\":{\"type\":\"string\"}},\"required\":[\"content\",\"expected_digest\"],\"type\":\"object\"},\"name\":\"polis_workspace_replace\",\"type\":\"function\"},{\"description\":\"Run the mediated peer candidate check and receive an evidence receipt.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{},\"required\":[],\"type\":\"object\"},\"name\":\"polis_workspace_check\",\"type\":\"function\"},{\"description\":\"Persist a progress or qualified peer checkpoint. Progress checkpoints preserve incomplete work; qualified checkpoints require passed check evidence and are eligible for final artifact submission.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"decisions\":{\"items\":{\"maxLength\":512,\"type\":\"string\"},\"maxItems\":8,\"minItems\":1,\"type\":\"array\"},\"evidence_refs\":{\"items\":{\"maxLength\":512,\"type\":\"string\"},\"maxItems\":8,\"minItems\":1,\"type\":\"array\"},\"facts\":{\"items\":{\"maxLength\":512,\"type\":\"string\"},\"maxItems\":8,\"minItems\":1,\"type\":\"array\"},\"failed_checks\":{\"items\":{\"maxLength\":512,\"type\":\"string\"},\"maxItems\":8,\"type\":\"array\"},\"kind\":{\"enum\":[\"progress\",\"qualified\"],\"type\":\"string\"},\"next_action\":{\"maxLength\":512,\"type\":\"string\"},\"rejected\":{\"items\":{\"maxLength\":512,\"type\":\"string\"},\"maxItems\":8,\"minItems\":1,\"type\":\"array\"},\"summary\":{\"maxLength\":512,\"type\":\"string\"}},\"required\":[\"decisions\",\"evidence_refs\",\"facts\",\"failed_checks\",\"kind\",\"next_action\",\"rejected\",\"summary\"],\"type\":\"object\"},\"name\":\"polis_work_checkpoint\",\"type\":\"function\"},{\"description\":\"Submit your checked frontend candidate.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{},\"required\":[],\"type\":\"object\"},\"name\":\"polis_artifact_submit\",\"type\":\"function\"},{\"description\":\"Resolve the peer obligation with your submitted candidate artifact.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"artifact_id\":{\"type\":\"string\"},\"obligation_id\":{\"type\":\"string\"}},\"required\":[\"artifact_id\",\"obligation_id\"],\"type\":\"object\"},\"name\":\"polis_obligation_resolve\",\"type\":\"function\"}],\"environments\":[],\"ephemeral\":true,\"model\":\"gpt-5.6-luna\",\"sandbox\":\"read-only\"}",
