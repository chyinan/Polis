{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-org:design:delivery-manifest:0.4.4",
  "description": "Disabled documentation fixture only; not a production authorization schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_version",
    "design_kind",
    "execution_enabled",
    "pay_enabled",
    "qualification",
    "delivery_id",
    "revision",
    "mission_id",
    "state",
    "source_revision",
    "environment_profile",
    "artifacts",
    "verification_status",
    "user_disposition",
    "download_counts_as_acceptance",
    "runtime_notes",
    "known_limitations",
    "secret_material_included",
    "preview_ref"
  ],
  "properties": {
    "document_version": {
      "const": "0.4.5"
    },
    "design_kind": {
      "const": "workflow_fixture_not_runtime_config"
    },
    "execution_enabled": {
      "const": false
    },
    "pay_enabled": {
      "const": false
    },
    "qualification": {
      "const": "unverified"
    },
    "delivery_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "null"
    },
    "environment_profile": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {},
      "maxItems": 1000
    },
    "verification_status": {
      "const": "not_run"
    },
    "user_disposition": {
      "type": "string",
      "minLength": 1
    },
    "download_counts_as_acceptance": {
      "const": false
    },
    "runtime_notes": {
      "type": "string",
      "minLength": 1
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 1000
    },
    "secret_material_included": {
      "const": false
    },
    "preview_ref": {
      "type": "null"
    }
  }
}
