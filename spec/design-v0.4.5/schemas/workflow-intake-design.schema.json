{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-org:design:intake:0.4.4",
  "description": "Disabled documentation fixture only; not a production authorization schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_version",
    "design_kind",
    "execution_enabled",
    "pay_enabled",
    "qualification",
    "company_id",
    "mission_id",
    "auto_start_mission",
    "external_processing_enabled",
    "formats",
    "assets",
    "limits_are_test_parameters",
    "limits",
    "secrets_included"
  ],
  "properties": {
    "document_version": {
      "const": "0.4.5"
    },
    "design_kind": {
      "const": "workflow_fixture_not_runtime_config"
    },
    "execution_enabled": {
      "const": false
    },
    "pay_enabled": {
      "const": false
    },
    "qualification": {
      "const": "unverified"
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "auto_start_mission": {
      "const": false
    },
    "external_processing_enabled": {
      "const": false
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 1000
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_ref",
          "kind",
          "source_hash",
          "status",
          "model_delivery_status",
          "representation_refs"
        ],
        "properties": {
          "asset_ref": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "source_hash": {
            "type": "null"
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "model_delivery_status": {
            "type": "string",
            "minLength": 1
          },
          "representation_refs": {
            "type": "array",
            "items": {},
            "maxItems": 1000
          }
        }
      },
      "maxItems": 1000
    },
    "limits_are_test_parameters": {
      "const": true
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upload_bytes",
        "unpacked_bytes",
        "archive_entries",
        "pdf_pages",
        "image_pixels"
      ],
      "properties": {
        "upload_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "unpacked_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "archive_entries": {
          "type": "integer",
          "minimum": 0
        },
        "pdf_pages": {
          "type": "integer",
          "minimum": 0
        },
        "image_pixels": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "secrets_included": {
      "const": false
    }
  }
}
