{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-org:design:event:0.4.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "design_fixture",
    "event_id",
    "company_id",
    "company_seq",
    "mission_id",
    "type",
    "actor",
    "correlation_id",
    "causation_id",
    "recorded_at",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "design_fixture": {
      "const": true
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "company_seq": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "object"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  }
}
