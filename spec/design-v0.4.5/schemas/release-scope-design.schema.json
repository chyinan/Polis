{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release-scope-design.schema.json",
  "type": "object",
  "required": [
    "document_version",
    "execution_enabled",
    "fixed_roles",
    "software_is_validation_domain_not_user_definition",
    "office_remains_deferred",
    "requirements"
  ],
  "properties": {
    "document_version": {
      "const": "0.4.5"
    },
    "execution_enabled": {
      "const": false
    },
    "fixed_roles": {
      "const": true
    },
    "software_is_validation_domain_not_user_definition": {
      "const": true
    },
    "office_remains_deferred": {
      "const": true
    },
    "requirements": {
      "type": "array",
      "minItems": 41,
      "maxItems": 41,
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "earliest_delivery",
          "implementation_status",
          "verification_status",
          "mandatory_safety_for_exposed_capability"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{2}$"
          },
          "earliest_delivery": {
            "enum": [
              "R1",
              "R2",
              "R3"
            ]
          },
          "implementation_status": {
            "const": "not_implemented"
          },
          "verification_status": {
            "const": "not_run"
          },
          "mandatory_safety_for_exposed_capability": {
            "const": true
          }
        }
      }
    }
  }
}
